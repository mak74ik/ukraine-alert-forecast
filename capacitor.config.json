{
  "appId": "ua.alert.forecast",
  "appName": "UA Alert Forecast",
  "webDir": "app/static",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_radar",
      "iconColor": "#EF4444",
      "sound": "siren.wav"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#030712"
    }
  },
  "android": {
    "allowMixedContent": true,
    "webContentsDebuggingEnabled": true
  }
}
